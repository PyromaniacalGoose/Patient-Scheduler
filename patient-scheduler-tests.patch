+def test_manually_selected_course_date_must_preserve_interval(staff_client, patient, room, now):
+    # Same-day, non-overlapping sessions fit the room but violate the requested
+    # 56-day interval. Exercise the public selection and confirmation paths.
+    planned = staff_client.post(reverse("start_course"), {
+        "patient_number": patient.patient_number, "appointment_count": 2,
+        "min_interval_days": 56, "soft_preferred_days": 77,
+        "treatment_type": 1, "earliest_start": "2026-10-26",
+    })
+    assert planned.status_code == 302
+    response = staff_client.post(reverse("select_window", kwargs={"appointment_index": 1}), {
+        "space_id": room.pk, "start": "2026-10-26T13:00:00+01:00", "end": "2026-10-26T17:30:00+01:00",
+    })
+    assert response.status_code in (200, 400, 422)
+    # Rejection may happen during selection or during confirmation. Either way,
+    # an invalid course must never be persisted.
+    if response.status_code == 200 and staff_client.session["pending_course"]["windows"][1]["start"].startswith("2026-10-26"):
+        confirmed = staff_client.post(reverse("review_course"))
+        assert confirmed.status_code in (200, 400, 422)
+        assert models.TreatmentAppointment.objects.count() == 0
+    else:
+        first, second = staff_client.session["pending_course"]["windows"]
+        assert (date.fromisoformat(second["start"][:10]) - date.fromisoformat(first["start"][:10])).days >= 56
+
